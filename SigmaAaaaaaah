RunService.RenderStepped:Connect(function()
    pcall(function()
        local color = Vars.FovCircleColor
        if Vars.FovCircleRainbow then color = Color3.fromHSV((tick()*0.5)%1,1,1) end
        local center = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
        local radius = Vars.AimbotFov
        if FovCircle then
            if not Vars.FovCircleEnabled then FovCircle.Visible = false; return end
            FovCircle.Visible = true
            FovCircle.Position = center
            FovCircle.Radius = radius
            FovCircle.Thickness = Vars.FovCircleThickness
            FovCircle.Filled = Vars.FovCircleFilled
            FovCircle.Color = color
        elseif FovLines then
            if not Vars.FovCircleEnabled then
                for _, l in ipairs(FovLines) do l.Visible = false end
                return
            end
            for i, l in ipairs(FovLines) do
                local a1 = (i / #FovLines) * math.pi * 2
                local a2 = ((i+1) / #FovLines) * math.pi * 2
                l.From = center + Vector2.new(math.cos(a1), math.sin(a1)) * radius
                l.To = center + Vector2.new(math.cos(a2), math.sin(a2)) * radius
                l.Color = color; l.Thickness = Vars.FovCircleThickness; l.Visible = true
            end
        end
    end)
end)

-- TRACERS
local function CreateTracer()
    pcall(function()
        if not Vars.TracerEnabled then return end
        local char = LP.Character
        if not char then return end
        local muzzle = nil
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            muzzle = tool:FindFirstChild("Handle") or tool:FindFirstChild("Barrel") or tool:FindFirstChild("Muzzle") or tool:FindFirstChildWhichIsA("BasePart")
        end
        if not muzzle then muzzle = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm") or char:FindFirstChild("HumanoidRootPart") end
        if not muzzle then return end
        local origin = Cam.CFrame.Position
        local params = RaycastParams.new()
        params.FilterType = excludeEnum
        params.FilterDescendantsInstances = {char, Cam}
        local res = workspace:Raycast(origin, Cam.CFrame.LookVector * 1000, params)
        local hitPos = res and res.Position or (origin + Cam.CFrame.LookVector * 1000)
        local startPos = muzzle.Position
        local dist = (hitPos - startPos).Magnitude
        if dist < 1 then return end
        local tracer = Instance.new("Part")
        tracer.Name = "SigmaTracer"
        tracer.Size = Vector3.new(Vars.TracerThickness, Vars.TracerThickness, dist)
        local ok, cf = pcall(function() return CFrame.lookAt(startPos, hitPos) end)
        if not ok then return end
        tracer.CFrame = cf * CFrame.new(0, 0, -dist/2)
        tracer.Anchored = true
        tracer.CanCollide = false
        tracer.CanQuery = false
        tracer.CanTouch = false
        tracer.Material = Enum.Material.Neon
        tracer.Color = Vars.TracerColor
        tracer.Transparency = Vars.TracerStartTransparency
        tracer.Parent = workspace
        if Vars.TracerGlow then
            local light = Instance.new("PointLight")
            light.Color = Vars.TracerColor; light.Brightness = 3; light.Range = 8
            light.Parent = tracer
        end
        local tween = TweenService:Create(tracer, TweenInfo.new(Vars.TracerLifetime, Enum.EasingStyle.Linear), { Transparency = 1 })
        tween:Play()
        Debris:AddItem(tracer, Vars.TracerLifetime + 0.1)
    end)
end

-- HIT SOUNDS
local hitSoundOriginals = {}
local function ApplyHitSoundToTool(tool)
    if not tool or not tool:IsA("Tool") then return end
    task.spawn(function()
        local ba = tool:FindFirstChild("BodyAttach") or tool:WaitForChild("BodyAttach", 5)
        if ba then
            for _, sn in ipairs({"HitClient","HeadShotClient","HitCharacterClient"}) do
                local s = ba:FindFirstChild(sn) or ba:WaitForChild(sn, 3)
                if s and s:IsA("Sound") then
                    if not hitSoundOriginals[s] then
                        hitSoundOriginals[s] = { SoundId = s.SoundId, Volume = s.Volume }
                    end
                    local id = HSList[Vars.HitSoundChoice] or ""
                    if id ~= "" then s.SoundId = id
                    else
                        local o = hitSoundOriginals[s]
                        if o then s.SoundId = o.SoundId end
                    end
                    s.Volume = Vars.HitSoundVolume
                end
            end
        end
    end)
end
local function ApplyHitSoundToChar(ch)
    if not ch then return end
    for _, c in ipairs(ch:GetChildren()) do
        if c:IsA("Tool") then ApplyHitSoundToTool(c) end
    end
end
local function RestoreHitSounds()
    for snd, d in pairs(hitSoundOriginals) do
        if snd and snd.Parent then pcall(function() snd.SoundId = d.SoundId; snd.Volume = d.Volume end) end
    end
    hitSoundOriginals = {}
end

