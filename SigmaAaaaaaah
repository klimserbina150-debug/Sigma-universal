-- ===== OPTIMIZATION =====
local RemovedParticles = {}
local RemovedPostFX = {}
local OriginalWater = {}

function ApplyOptimization()
    if Toggles.OptNoShadows.Value then
        Lighting.GlobalShadows = false
        for _, p in ipairs(workspace:GetDescendants()) do
            if p:IsA("BasePart") and p.CastShadow then
                pcall(function() p.CastShadow = false end)
            end
        end
    end
    if Toggles.OptNoParticles.Value then
        for _, p in ipairs(workspace:GetDescendants()) do
            if p:IsA("ParticleEmitter") or p:IsA("Smoke") or p:IsA("Fire")
               or p:IsA("Sparkles") or p:IsA("Beam") or p:IsA("Trail") then
                if p.Enabled then p.Enabled = false; table.insert(RemovedParticles, p) end
            end
        end
    end
    if Toggles.OptNoPostFX.Value then
        for _, fx in ipairs(Lighting:GetChildren()) do
            if fx:IsA("PostEffect") or fx:IsA("Atmosphere") then
                if fx.Enabled ~= nil then fx.Enabled = false; table.insert(RemovedPostFX, fx) end
            end
        end
    end
    if Toggles.OptNoWaterWaves.Value then
        local terrain = workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            pcall(function()
                OriginalWater = {WaterWaveSize = terrain.WaterWaveSize, WaterWaveSpeed = terrain.WaterWaveSpeed, WaterReflectance = terrain.WaterReflectance, WaterTransparency = terrain.WaterTransparency}
                terrain.WaterWaveSize = 0; terrain.WaterWaveSpeed = 0
                terrain.WaterReflectance = 0; terrain.WaterTransparency = 1
            end)
        end
    end
    if Toggles.OptNoTextures.Value then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("Decal") or d:IsA("Texture") then
                pcall(function() d.Transparency = 1 end)
            end
        end
    end
    pcall(function() settings().Rendering.QualityLevel = Options.OptQuality.Value end)
    Library:Notify("Optimization applied", 3)
end

function RestoreGraphics()
    for _, p in ipairs(RemovedParticles) do pcall(function() if p and p.Parent then p.Enabled = true end end) end
    RemovedParticles = {}
    for _, fx in ipairs(RemovedPostFX) do pcall(function() if fx and fx.Parent and fx.Enabled ~= nil then fx.Enabled = true end end) end
    RemovedPostFX = {}
    Lighting.GlobalShadows = Def.GlobalShadows
    local terrain = workspace:FindFirstChildOfClass("Terrain")
    if terrain and OriginalWater.WaterWaveSize then
        pcall(function()
            terrain.WaterWaveSize = OriginalWater.WaterWaveSize
            terrain.WaterWaveSpeed = OriginalWater.WaterWaveSpeed
            terrain.WaterReflectance = OriginalWater.WaterReflectance
            terrain.WaterTransparency = OriginalWater.WaterTransparency
        end)
    end
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("Decal") or d:IsA("Texture") then pcall(function() d.Transparency = 0 end) end
    end
    pcall(function() settings().Rendering.QualityLevel = 10 end)
    Library:Notify("Graphics restored", 3)
end

