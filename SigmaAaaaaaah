-- OPTIMIZATION
local RemovedParticles, RemovedPostFX, OriginalWater = {}, {}, {}
function ApplyOptimization()
    if Vars.OptNoShadows then
        Lighting.GlobalShadows = false
        for _, p in ipairs(workspace:GetDescendants()) do
            if p:IsA("BasePart") and p.CastShadow then pcall(function() p.CastShadow = false end) end
        end
    end
    if Vars.OptNoParticles then
        for _, p in ipairs(workspace:GetDescendants()) do
            if p:IsA("ParticleEmitter") or p:IsA("Smoke") or p:IsA("Fire") or p:IsA("Sparkles") or p:IsA("Beam") or p:IsA("Trail") then
                if p.Enabled then p.Enabled = false; table.insert(RemovedParticles, p) end
            end
        end
    end
    if Vars.OptNoPostFX then
        for _, fx in ipairs(Lighting:GetChildren()) do
            if fx:IsA("PostEffect") or fx:IsA("Atmosphere") then
                if fx.Enabled ~= nil then fx.Enabled = false; table.insert(RemovedPostFX, fx) end
            end
        end
    end
    if Vars.OptNoWaterWaves then
        local terrain = workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            pcall(function()
                OriginalWater = {WaterWaveSize=terrain.WaterWaveSize, WaterWaveSpeed=terrain.WaterWaveSpeed, WaterReflectance=terrain.WaterReflectance, WaterTransparency=terrain.WaterTransparency}
                terrain.WaterWaveSize = 0; terrain.WaterWaveSpeed = 0
                terrain.WaterReflectance = 0; terrain.WaterTransparency = 1
            end)
        end
    end
    if Vars.OptNoTextures then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("Decal") or d:IsA("Texture") then pcall(function() d.Transparency = 1 end) end
        end
    end
    pcall(function() settings().Rendering.QualityLevel = Vars.OptQuality end)
    pcall(function() Library:Notify("Optimization applied", 3) end)
end

function RestoreGraphics()
    for _, p in ipairs(RemovedParticles) do pcall(function() if p and p.Parent then p.Enabled = true end end) end
    RemovedParticles = {}
    for _, fx in ipairs(RemovedPostFX) do pcall(function() if fx and fx.Parent and fx.Enabled ~= nil then fx.Enabled = true end end) end
    RemovedPostFX = {}
    Lighting.GlobalShadows = Def.GlobalShadows
    local terrain = workspace:FindFirstChildOfClass("Terrain")
    if terrain and OriginalWater.WaterWaveSize then
        pcall(function()
            terrain.WaterWaveSize = OriginalWater.WaterWaveSize
            terrain.WaterWaveSpeed = OriginalWater.WaterWaveSpeed
            terrain.WaterReflectance = OriginalWater.WaterReflectance
            terrain.WaterTransparency = OriginalWater.WaterTransparency
        end)
    end
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("Decal") or d:IsA("Texture") then pcall(function() d.Transparency = 0 end) end
    end
    pcall(function() settings().Rendering.QualityLevel = 10 end)
    pcall(function() Library:Notify("Graphics restored", 3) end)
end

-- ESP
ESP_Data = ESP_Data or {}
function MakeESP(p)
    if not p or p == LP then return end
    if ESP_Data[p] then for _, d in pairs(ESP_Data[p]) do pcall(function() d:Remove() end) end end
    local ok, data = pcall(function()
        return {
            box=Drawing.new("Square"), name=Drawing.new("Text"),
            dist=Drawing.new("Text"), health=Drawing.new("Square"),
        }
    end)
    if not ok or not data then return end
    pcall(function()
        data.box.Visible=false; data.box.Thickness=1; data.box.Filled=false
        data.name.Visible=false; data.name.Size=14; data.name.Center=true; data.name.Outline=true
        data.dist.Visible=false; data.dist.Size=13; data.dist.Center=true; data.dist.Outline=true
        data.health.Visible=false; data.health.Thickness=1; data.health.Filled=true
    end)
    ESP_Data[p] = data
end
local function RemoveESP(p)
    if ESP_Data[p] then for _, d in pairs(ESP_Data[p]) do pcall(function() d:Remove() end) end; ESP_Data[p] = nil end
end
for _, p in ipairs(Players:GetPlayers()) do pcall(MakeESP, p) end
Players.PlayerAdded:Connect(function(p) pcall(MakeESP, p) end)
Players.PlayerRemoving:Connect(RemoveESP)

RunService.RenderStepped:Connect(function()
    pcall(function()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and not ESP_Data[p] then MakeESP(p) end
        end
        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        for p, data in pairs(ESP_Data) do
            local hide = not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") or not myRoot
            if not hide and Vars.ESPTeamCheck and p.Team == LP.Team then hide = true end
            if hide then
                data.box.Visible=false; data.name.Visible=false
                data.dist.Visible=false; data.health.Visible=false
            else
                local root = p.Character.HumanoidRootPart
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local head = p.Character:FindFirstChild("Head") or root
                local distStuds = (myRoot.Position - root.Position).Magnitude
                if distStuds > Vars.ESPMaxDistance then
                    data.box.Visible=false; data.name.Visible=false
                    data.dist.Visible=false; data.health.Visible=false
                else
                    local pos, onScreen = Cam:WorldToViewportPoint(root.Position)
                    local headPos = Cam:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
                    if not onScreen then
                        data.box.Visible=false; data.name.Visible=false
                        data.dist.Visible=false; data.health.Visible=false
                    else
                        local height = math.abs(pos.Y - headPos.Y) * 2.2
                        local width = height * 0.6
                        local boxPos = Vector2.new(pos.X - width/2, pos.Y - height/2)
                        data.box.Visible = Vars.ESPBox
                        data.box.Color = Vars.ESPBoxColor
                        data.box.Size = Vector2.new(width, height)
                        data.box.Position = boxPos
                        data.name.Visible = Vars.ESPName
                        data.name.Color = Vars.ESPTextColor
                        data.name.Text = p.Name
                        data.name.Position = Vector2.new(pos.X, boxPos.Y - 36)
                        data.name.Center = true
                        data.dist.Visible = Vars.ESPDistance
                        data.dist.Color = Vars.ESPTextColor
                        data.dist.Text = "[" .. math.floor(distStuds) .. "m]"
                        data.dist.Position = Vector2.new(pos.X, boxPos.Y - 20)
                        data.dist.Center = true
                        if Vars.ESPHealthBar and hum then
                            data.health.Visible = true
                            local hp = hum.Health / hum.MaxHealth
                            data.health.Color = Color3.fromRGB(255*(1-hp), 255*hp, 0)
                            data.health.Size = Vector2.new(3, height*hp)
                            data.health.Position = Vector2.new(boxPos.X - 6, boxPos.Y + height*(1-hp))
                        else data.health.Visible = false end
                    end
                end
            end
        end
    end)
end)

-- CHAMS
local chams = {}
local function ApplyChams(p)
    if p == LP or not p.Character then return end
    if chams[p] then pcall(function() chams[p]:Destroy() end) end
    local ok, hl = pcall(function()
        local h = Instance.new("Highlight")
        h.Name = "SigmaChams"
        h.FillColor = Vars.ChamsFill; h.OutlineColor = Vars.ChamsOutline
        h.FillTransparency = Vars.ChamsTransparency; h.OutlineTransparency = 0
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = p.Character
        return h
    end)
    if ok then chams[p] = hl end
end
local function RemoveChams(p)
    if chams[p] then pcall(function() chams[p]:Destroy() end); chams[p] = nil end
end
RunService.Heartbeat:Connect(function()
    pcall(function()
        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LP then continue end
            local show = Vars.ChamsEnabled and p.Character and myRoot
            if show and Vars.ChamsTeamCheck and p.Team == LP.Team then show = false end
            if show then
                local root = p.Character:FindFirstChild("HumanoidRootPart")
                if not root or (myRoot.Position - root.Position).Magnitude > Vars.ChamsMaxDistance then show = false end
            end
            if show then
                if not chams[p] or not chams[p].Parent then ApplyChams(p) end
                if chams[p] then
                    chams[p].FillTransparency = Vars.ChamsTransparency
                    chams[p].OutlineColor = Vars.ChamsOutline
                    if Vars.ChamsRainbow then chams[p].FillColor = Color3.fromHSV((tick()*0.5)%1,1,1)
                    else chams[p].FillColor = Vars.ChamsFill end
                end
            elseif chams[p] then RemoveChams(p) end
        end
    end)
end)
Players.PlayerRemoving:Connect(RemoveChams)

