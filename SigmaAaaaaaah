end)

-- TRIGGER BOT
local lastTriggerTime = 0
local function ClickMouse()
    if mouse1click then pcall(mouse1click); return true end
    if mouse1press and mouse1release then pcall(function() mouse1press(); task.wait(0.02); mouse1release() end); return true end
    if keypress and keyrelease then pcall(function() keypress(0x01); task.wait(0.02); keyrelease(0x01) end); return true end
    pcall(function()
        local VIM = game:GetService("VirtualInputManager")
        local ml = UIS:GetMouseLocation()
        VIM:SendMouseButtonEvent(ml.X, ml.Y, 0, true, game, 0)
        task.wait(0.02)
        VIM:SendMouseButtonEvent(ml.X, ml.Y, 0, false, game, 0)
    end)
    return true
end

RunService.RenderStepped:Connect(function()
    pcall(function()
        if not Vars.TriggerBotEnabled then return end
        local now = tick()
        if now - lastTriggerTime < Vars.TriggerBotDelay then return end
        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        local center = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
        local found = false
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                if Vars.ESPTeamCheck and p.Team == LP.Team then continue end
                if IsIgnoredByTrigger(p) then continue end
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local pRoot = p.Character.HumanoidRootPart
                    if (myRoot.Position - pRoot.Position).Magnitude > Vars.TriggerBotMaxDistance then continue end
                    if Vars.TriggerBotVisibleCheck and not IsVisible(p.Character, Vars.TriggerBotTarget) then continue end
                    local targetPart = GetTargetPart(p.Character, Vars.TriggerBotTarget)
                    if targetPart then
                        local pos, onScreen = Cam:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                            if d < Vars.TriggerBotFov then found = true; break end
                        end
                    end
                end
            end
        end
        if found then ClickMouse(); lastTriggerTime = now end
    end)
end)

