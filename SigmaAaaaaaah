    elseif input.UserInputType == Enum.UserInputType.MouseButton3 then mouseStates.MouseButton3 = true end
    if input.KeyCode ~= Enum.KeyCode.Unknown then keyStates[input.KeyCode.Name] = true end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then mouseStates.MouseButton1 = false
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then mouseStates.MouseButton2 = false
    elseif input.UserInputType == Enum.UserInputType.MouseButton3 then mouseStates.MouseButton3 = false end
    if input.KeyCode ~= Enum.KeyCode.Unknown then keyStates[input.KeyCode.Name] = false end
end)

local function IsKeybindActive(keyStr)
    if not keyStr or keyStr == "" then return false end
    keyStr = tostring(keyStr)
    if keyStr:find("MouseButton") then return mouseStates[keyStr] == true end
    return keyStates[keyStr] == true
end

