ESP_Data = ESP_Data or {}

function MakeESP(p)
    if p == LP then return end
    if ESP_Data[p] then for _, d in pairs(ESP_Data[p]) do pcall(function() d:Remove() end) end end
    local ok, data = pcall(function()
        return {
            box=Drawing.new("Square"), name=Drawing.new("Text"),
            dist=Drawing.new("Text"), health=Drawing.new("Square"),
        }
    end)
    if not ok or not data then return end
    pcall(function()
        data.box.Visible=false; data.box.Thickness=1; data.box.Filled=false
        data.name.Visible=false; data.name.Size=14; data.name.Center=true; data.name.Outline=true
        data.dist.Visible=false; data.dist.Size=13; data.dist.Center=true; data.dist.Outline=true
        data.health.Visible=false; data.health.Thickness=1; data.health.Filled=true
    end)
    ESP_Data[p] = data
end

local function RemoveESP(p)
    if ESP_Data[p] then for _, d in pairs(ESP_Data[p]) do pcall(function() d:Remove() end) end; ESP_Data[p] = nil end
end

for _, p in ipairs(Players:GetPlayers()) do pcall(MakeESP, p) end
Players.PlayerAdded:Connect(function(p) pcall(MakeESP, p) end)
Players.PlayerRemoving:Connect(RemoveESP)

RunService.RenderStepped:Connect(function()
    pcall(function()
        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local maxDist = Vars.ESPMaxDistance
        for p, data in pairs(ESP_Data) do
            local hide = not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") or not myRoot
            if not hide and Vars.ESPTeamCheck and p.Team == LP.Team then hide = true end
            if hide then
                data.box.Visible=false; data.name.Visible=false
                data.dist.Visible=false; data.health.Visible=false
            else
                local root = p.Character.HumanoidRootPart
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local head = p.Character:FindFirstChild("Head") or root
                local distStuds = (myRoot.Position - root.Position).Magnitude
                if distStuds > maxDist then
                    data.box.Visible=false; data.name.Visible=false
                    data.dist.Visible=false; data.health.Visible=false
                else
                    local pos, onScreen = Cam:WorldToViewportPoint(root.Position)
                    local headPos = Cam:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
                    if not onScreen then
                        data.box.Visible=false; data.name.Visible=false
                        data.dist.Visible=false; data.health.Visible=false
                    else
                        local height = math.abs(pos.Y - headPos.Y) * 2.2
                        local width = height * 0.6
                        local boxPos = Vector2.new(pos.X - width/2, pos.Y - height/2)
                        data.box.Visible = Vars.ESPBox
                        data.box.Color = Vars.ESPBoxColor
                        data.box.Size = Vector2.new(width, height)
                        data.box.Position = boxPos
                        data.name.Visible = Vars.ESPName
                        data.name.Color = Vars.ESPTextColor
                        data.name.Text = p.Name
                        data.name.Position = Vector2.new(pos.X, boxPos.Y - 36)
                        data.name.Center = true
                        data.dist.Visible = Vars.ESPDistance
                        data.dist.Color = Vars.ESPTextColor
                        data.dist.Text = "[" .. math.floor(distStuds) .. "m]"
                        data.dist.Position = Vector2.new(pos.X, boxPos.Y - 20)
                        data.dist.Center = true
                        if Vars.ESPHealthBar and hum then
                            data.health.Visible = true
                            local hp = hum.Health / hum.MaxHealth
                            data.health.Color = Color3.fromRGB(255*(1-hp), 255*hp, 0)
                            data.health.Size = Vector2.new(3, height*hp)
                            data.health.Position = Vector2.new(boxPos.X - 6, boxPos.Y + height*(1-hp))
                        else
                            data.health.Visible = false
                        end
                    end
                end
            end
        end
    end)
end)

