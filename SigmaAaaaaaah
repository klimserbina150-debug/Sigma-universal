local function IsIgnoredByAim(p)
    if not p or not Vars.AimbotIgnoreList then return false end
    return Vars.AimbotIgnoreList[p.Name] == true
end
local function IsIgnoredByTrigger(p)
    if not p or not Vars.TriggerBotIgnoreList then return false end
    return Vars.TriggerBotIgnoreList[p.Name] == true
end

-- TARGET PART
local function GetTargetPart(char, mode)
    if not char then return nil end
    mode = mode or "Head"
    if mode == "Head" then
        return char:FindFirstChild("Head") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    elseif mode == "Torso" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    elseif mode == "HumanoidRootPart" then
        return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("Head")
    end
    return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

-- VISIBLE CHECK
local excludeEnum = Enum.RaycastFilterType.Exclude or Enum.RaycastFilterType.Blacklist
local function IsVisible(targetChar, mode)
    local ok, result = pcall(function()
        if not targetChar then return false end
        local myChar = LP.Character
        if not myChar then return false end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        local targetPart = GetTargetPart(targetChar, mode)
        if not myRoot or not targetPart then return false end
        local params = RaycastParams.new()
        params.FilterType = excludeEnum
        params.FilterDescendantsInstances = {myChar, targetChar, Cam}
        local res = workspace:Raycast(Cam.CFrame.Position, (targetPart.Position - Cam.CFrame.Position), params)
        return res == nil
    end)
    return ok and result or false
end

-- AIMBOT
local function GetClosestPlayer()
    local ok, result = pcall(function()
        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot then return nil end
        local target, shortest = nil, Vars.AimbotFov
        local center = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                if Vars.ESPTeamCheck and p.Team == LP.Team then continue end
                if IsIgnoredByAim(p) then continue end
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local pRoot = p.Character.HumanoidRootPart
                    if (myRoot.Position - pRoot.Position).Magnitude > Vars.AimbotMaxDistance then continue end
                    if Vars.AimbotVisibleCheck and not IsVisible(p.Character, Vars.AimbotTarget) then continue end
                    local targetPart = GetTargetPart(p.Character, Vars.AimbotTarget)
                    if not targetPart then continue end
                    local pos, onScreen = Cam:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if d < shortest then shortest = d; target = p.Character end
                    end
                end
            end
        end
        return target
    end)
    return ok and result or nil
end

RunService.RenderStepped:Connect(function()
    pcall(function()
        if not Vars.AimbotEnabled then return end
        if not Vars.AimbotAlways and not IsKeybindActive(Vars.AimbotKeybind) then return end
        local t = GetClosestPlayer()
        if t then
            local targetPart = GetTargetPart(t, Vars.AimbotTarget)
            local root = t:FindFirstChild("HumanoidRootPart")
            if targetPart and root then
                local targetPos = targetPart.Position + root.Velocity * Vars.AimbotPrediction
                Cam.CFrame = Cam.CFrame:Lerp(CFrame.new(Cam.CFrame.Position, targetPos), 1 / Vars.AimbotSmoothness)
            end
        end
    end)
end)

-- HITBOX EXPANDER
local function ApplyHitbox(char)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local old = char:FindFirstChild("SigmaHitbox")
    if old then pcall(function() old:Destroy() end) end
    local hitbox = Instance.new("Part")
    hitbox.Name = "SigmaHitbox"
    hitbox.Size = hrp.Size * Vars.HitboxScale
    hitbox.Transparency = 1
    hitbox.CanCollide = false
    hitbox.CanQuery = true
    hitbox.CanTouch = true
    hitbox.Massless = true
    hitbox.Anchored = false
    hitbox.Parent = char
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = hitbox; weld.Part1 = hrp; weld.Parent = hitbox
    hitbox.CFrame = hrp.CFrame
end

