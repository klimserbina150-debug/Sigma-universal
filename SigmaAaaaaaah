                if not root or (myRoot.Position - root.Position).Magnitude > Vars.ChamsMaxDistance then show = false end
            end
            if show then
                if not chams[p] or not chams[p].Parent then ApplyChams(p) end
                if chams[p] then
                    chams[p].FillTransparency = Vars.ChamsTransparency
                    chams[p].OutlineColor = Vars.ChamsOutline
                    if Vars.ChamsRainbow then chams[p].FillColor = Color3.fromHSV((tick()*0.5)%1,1,1)
                    else chams[p].FillColor = Vars.ChamsFill end
                end
            elseif chams[p] then RemoveChams(p) end
        end
    end)
end)
