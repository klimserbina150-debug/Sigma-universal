ESP_Data = ESP_Data or {}

function MakeESP(p)
    if p == LP then return end
    if ESP_Data[p] then for _, d in pairs(ESP_Data[p]) do pcall(function() d:Remove() end) end end
    local data = {
        box = Drawing.new("Square"), name = Drawing.new("Text"),
        dist = Drawing.new("Text"), health = Drawing.new("Square"),
    }
    data.box.Visible = false; data.box.Thickness = 1; data.box.Filled = false
    data.name.Visible = false; data.name.Size = 14; data.name.Center = true; data.name.Outline = true
    data.dist.Visible = false; data.dist.Size = 13; data.dist.Center = true; data.dist.Outline = true
    data.health.Visible = false; data.health.Thickness = 1; data.health.Filled = true
    ESP_Data[p] = data
end

local function RemoveESP(p)
    if ESP_Data[p] then for _, d in pairs(ESP_Data[p]) do pcall(function() d:Remove() end) end; ESP_Data[p] = nil end
end

for _, p in ipairs(Players:GetPlayers()) do MakeESP(p) end
