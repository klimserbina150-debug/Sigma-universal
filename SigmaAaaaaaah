local function ApplyChams(p)
    if p == LP or not p.Character then return end
    if chams[p] then pcall(function() chams[p]:Destroy() end) end
    local ok, hl = pcall(function()
        local h = Instance.new("Highlight"); h.Name = "SigmaChams"
        h.FillColor = Vars.ChamsFill; h.OutlineColor = Vars.ChamsOutline
        h.FillTransparency = Vars.ChamsTransparency; h.OutlineTransparency = 0
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; h.Parent = p.Character; return h
    end)
    if ok then chams[p] = hl end
end
local function RemoveChams(p)
    if chams[p] then pcall(function() chams[p]:Destroy() end); chams[p] = nil end
end
