local function ApplyFont(fontName)
    local fontEnum = Enum.Font[fontName]
    if not fontEnum then return end
    local cg = game:GetService("CoreGui")
    for _, gui in ipairs(cg:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= "SigmaWatermark" and gui.Name ~= "SigmaStats" then
            local isOurs = false
            for _, obj in ipairs(gui:GetDescendants()) do
                if obj:IsA("TextLabel") and obj.Text == "Sigma Universal" then isOurs = true; break end
            end
            if isOurs then
                for _, obj in ipairs(gui:GetDescendants()) do
                    if obj:IsA("TextLabel") or obj:IsA("TextButton") then pcall(function() obj.Font = fontEnum end) end
                end
            end
        end
    end
end

