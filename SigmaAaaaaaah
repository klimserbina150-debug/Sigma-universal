-- ============================================================
-- VISIBLE CHECK
-- ============================================================
local excludeEnum = Enum.RaycastFilterType.Exclude or Enum.RaycastFilterType.Blacklist

local function IsVisible(targetChar)
    local ok, result = pcall(function()
        if not targetChar then return false end
        local myChar = LP.Character
        if not myChar then return false end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        local targetHead = targetChar:FindFirstChild("Head") or targetRoot
        if not myRoot or not targetRoot or not targetHead then return false end
        local origin = Cam.CFrame.Position
        local targetPos = Vars.AimbotMultipoint and targetHead.Position or targetRoot.Position
        local params = RaycastParams.new()
        params.FilterType = excludeEnum
        params.FilterDescendantsInstances = {myChar, targetChar, Cam}
        local res = workspace:Raycast(origin, (targetPos - origin), params)
        return res == nil
    end)
    return ok and result or false
end

-- ============================================================
-- AIMBOT (использует Vars.*)
-- ============================================================
local function GetClosestPlayer()
    local ok, result = pcall(function()
        local target, shortest = nil, Vars.AimbotFov
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                if Vars.ESPTeamCheck and p.Team == LP.Team then continue end
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    if Vars.AimbotVisibleCheck and not IsVisible(p.Character) then continue end
                    local pos, onScreen = Cam:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
                    if onScreen then
                        local d = (Vector2.new(pos.X, pos.Y) - UIS:GetMouseLocation()).Magnitude
                        if d < shortest then shortest = d; target = p.Character end
                    end
                end
            end
        end
        return target
    end)
    return ok and result or nil
end

RunService.RenderStepped:Connect(function()
    pcall(function()
        if not Vars.AimbotEnabled then return end
        if not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
        local t = GetClosestPlayer()
        if t and t:FindFirstChild("HumanoidRootPart") then
            local root = t.HumanoidRootPart
            local head = t:FindFirstChild("Head") or root
            local targetPos = Vars.AimbotMultipoint and head.Position or root.Position
            local pred = targetPos + root.Velocity * Vars.AimbotPrediction
            Cam.CFrame = Cam.CFrame:Lerp(CFrame.new(Cam.CFrame.Position, pred), 1 / Vars.AimbotSmoothness)
        end
    end)
end)

