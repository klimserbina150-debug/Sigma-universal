local lastShotTick, lastHitSoundTick = 0, 0
local function PlayHitSound()
    if not Vars.HitSoundEnabled or Vars.HitSoundChoice == "None" then return end
    local id = HSList[Vars.HitSoundChoice] or ""; if id == "" then return end
    pcall(function()
        local snd = Instance.new("Sound"); snd.SoundId = id; snd.Volume = Vars.HitSoundVolume
        snd.Parent = LP.Character or workspace; snd:Play(); Debris:AddItem(snd, 3)
    end)
