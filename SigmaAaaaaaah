-- IGNORE / TARGET / VISIBLE
local function IsIgnoredByAim(p)
    if not p or not Vars.AimbotIgnoreList then return false end
    return Vars.AimbotIgnoreList[p.Name] == true
end
local function IsIgnoredByTrigger(p)
    if not p or not Vars.TriggerBotIgnoreList then return false end
    return Vars.TriggerBotIgnoreList[p.Name] == true
end
local function GetTargetPart(char, mode)
    if not char then return nil end
    mode = mode or "Head"
    if mode == "Head" then return char:FindFirstChild("Head") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    elseif mode == "Torso" then return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    elseif mode == "HumanoidRootPart" then return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("Head")
    end
    return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end
local excludeEnum = Enum.RaycastFilterType.Exclude or Enum.RaycastFilterType.Blacklist
local function IsVisible(targetChar, mode)
    local ok, result = pcall(function()
        if not targetChar then return false end
        local myChar = LP.Character
        if not myChar then return false end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        local targetPart = GetTargetPart(targetChar, mode)
        if not myRoot or not targetPart then return false end
        local params = RaycastParams.new()
        params.FilterType = excludeEnum
        params.FilterDescendantsInstances = {myChar, targetChar, Cam}
        local res = workspace:Raycast(Cam.CFrame.Position, (targetPart.Position - Cam.CFrame.Position), params)
        return res == nil
    end)
    return ok and result or false
end

-- AIMBOT
local function GetClosestPlayer()
    local ok, result = pcall(function()
        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot then return nil end
        local target, shortest = nil, Vars.AimbotFov
        local center = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                if Vars.ESPTeamCheck and p.Team == LP.Team then continue end
                if IsIgnoredByAim(p) then continue end
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local pRoot = p.Character.HumanoidRootPart
                    if (myRoot.Position - pRoot.Position).Magnitude > Vars.AimbotMaxDistance then continue end
                    if Vars.AimbotVisibleCheck and not IsVisible(p.Character, Vars.AimbotTarget) then continue end
                    local targetPart = GetTargetPart(p.Character, Vars.AimbotTarget)
                    if not targetPart then continue end
                    local pos, onScreen = Cam:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if d < shortest then shortest = d; target = p.Character end
                    end
                end
            end
        end
        return target
    end)
    return ok and result or nil
end

RunService.RenderStepped:Connect(function()
    pcall(function()
        if not Vars.AimbotEnabled then return end
        if not Vars.AimbotAlways and not IsKeybindActive(Vars.AimbotKeybind) then return end
        local t = GetClosestPlayer()
        if t then
            local targetPart = GetTargetPart(t, Vars.AimbotTarget)
            local root = t:FindFirstChild("HumanoidRootPart")
            if targetPart and root then
                local targetPos = targetPart.Position + root.Velocity * Vars.AimbotPrediction
                Cam.CFrame = Cam.CFrame:Lerp(CFrame.new(Cam.CFrame.Position, targetPos), 1 / Vars.AimbotSmoothness)
            end
        end
    end)
end)

-- BIG HEAD
local originalHeadData = {}

local function GetHeadData(char, head, hum)
    local data = originalHeadData[char]
    if data then return data end
    data = { headSize = head.Size, meshScale = nil, headScale = nil }
    local mesh = head:FindFirstChildOfClass("SpecialMesh")
    if mesh then data.meshScale = mesh.Scale end
    if hum then
        local hs = hum:FindFirstChild("HeadScale")
        if hs and hs:IsA("NumberValue") then data.headScale = hs.Value end
    end
    originalHeadData[char] = data
    return data
end

local function ApplyBigHead(char)
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head or not head:IsA("BasePart") then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local data = GetHeadData(char, head, hum)
    local scale = Vars.BigHeadScale
    local transp = Vars.BigHeadTransparency or 0
    pcall(function() head.Size = data.headSize * scale end)
    pcall(function() head.Transparency = transp end)
    local mesh = head:FindFirstChildOfClass("SpecialMesh")
    if mesh and data.meshScale then pcall(function() mesh.Scale = data.meshScale * scale end) end
    if hum then
        local hs = hum:FindFirstChild("HeadScale")
        if hs and hs:IsA("NumberValue") and data.headScale then
            pcall(function() hs.Value = data.headScale * scale end)
        end
    end
end

local function RestoreBigHead(char)
    if not char then return end
    local data = originalHeadData[char]
    if not data then return end
    local head = char:FindFirstChild("Head")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if head and head:IsA("BasePart") then
        pcall(function() head.Size = data.headSize; head.Transparency = 0 end)
        local mesh = head:FindFirstChildOfClass("SpecialMesh")
        if mesh and data.meshScale then pcall(function() mesh.Scale = data.meshScale end) end
    end
    if hum then
        local hs = hum:FindFirstChild("HeadScale")
        if hs and hs:IsA("NumberValue") and data.headScale then pcall(function() hs.Value = data.headScale end) end
    end
    originalHeadData[char] = nil
end

local function BigHeadLoop()
    pcall(function()
        if not Vars.BigHeadEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP and p.Character then RestoreBigHead(p.Character) end
            end
            return
        end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                if Vars.BigHeadTeamCheck and p.Team == LP.Team then RestoreBigHead(p.Character); continue end
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then ApplyBigHead(p.Character)
                else RestoreBigHead(p.Character) end
            end
        end
    end)
end
RunService.RenderStepped:Connect(BigHeadLoop)
RunService.Heartbeat:Connect(BigHeadLoop)
RunService.Stepped:Connect(BigHeadLoop)

