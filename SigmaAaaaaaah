-- ============================================================
local chams = {}

local function ApplyChams(p)
    if p == LP or not p.Character then return end
    if chams[p] then pcall(function() chams[p]:Destroy() end) end
    local ok, hl = pcall(function()
        local h = Instance.new("Highlight")
        h.Name = "SigmaChams"
        h.FillColor = Vars.ChamsFill
        h.OutlineColor = Vars.ChamsOutline
        h.FillTransparency = Vars.ChamsTransparency
        h.OutlineTransparency = 0
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = p.Character
        return h
    end)
    if ok then chams[p] = hl end
end

local function RemoveChams(p)
    if chams[p] then pcall(function() chams[p]:Destroy() end); chams[p] = nil end
end

RunService.Heartbeat:Connect(function()
    pcall(function()
        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local maxDist = Vars.ChamsMaxDistance
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LP then continue end
            local show = Vars.ChamsEnabled and p.Character and myRoot
            if show and Vars.ChamsTeamCheck and p.Team == LP.Team then show = false end
            if show then
                local root = p.Character:FindFirstChild("HumanoidRootPart")
                if not root or (myRoot.Position - root.Position).Magnitude > maxDist then show = false end
            end
            if show then
                if not chams[p] or not chams[p].Parent then ApplyChams(p) end
                if chams[p] then
                    chams[p].FillTransparency = Vars.ChamsTransparency
                    chams[p].OutlineColor = Vars.ChamsOutline
                    if Vars.ChamsRainbow then
                        chams[p].FillColor = Color3.fromHSV((tick()*0.5)%1,1,1)
                    else
                        chams[p].FillColor = Vars.ChamsFill
                    end
                end
            elseif chams[p] then
                RemoveChams(p)
            end
        end
    end)
end)

Players.PlayerRemoving:Connect(RemoveChams)

