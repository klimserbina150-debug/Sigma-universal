-- ============================================================
local FovCircle, FovLines = nil, nil
pcall(function()
    FovCircle = Drawing.new("Circle")
    FovCircle.Visible = false; FovCircle.Transparency = 1; FovCircle.NumSides = 60
end)
if not FovCircle then
    FovLines = {}
    for i = 1, 60 do
        local l = Drawing.new("Line")
        l.Visible = false; l.Thickness = 2
        table.insert(FovLines, l)
    end
end

RunService.RenderStepped:Connect(function()
    pcall(function()
        local color = Vars.FovCircleColor
        if Vars.FovCircleRainbow then color = Color3.fromHSV((tick()*0.5)%1,1,1) end
        local radius = Vars.AimbotFov
        local center = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
        if FovCircle then
            if not Vars.FovCircleEnabled then FovCircle.Visible = false; return end
            FovCircle.Visible = true
            FovCircle.Position = center
            FovCircle.Radius = radius
            FovCircle.Thickness = Vars.FovCircleThickness
            FovCircle.Filled = Vars.FovCircleFilled
            FovCircle.Color = color
        elseif FovLines then
            if not Vars.FovCircleEnabled then
                for _, l in ipairs(FovLines) do l.Visible = false end
                return
            end
            for i, l in ipairs(FovLines) do
                local a1 = (i / #FovLines) * math.pi * 2
                local a2 = ((i+1) / #FovLines) * math.pi * 2
                l.From = center + Vector2.new(math.cos(a1), math.sin(a1)) * radius
                l.To = center + Vector2.new(math.cos(a2), math.sin(a2)) * radius
                l.Color = color; l.Thickness = Vars.FovCircleThickness; l.Visible = true
            end
        end
    end)
end)

