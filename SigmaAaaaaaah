-- ===== VISIBLE CHECK =====
local function IsVisible(targetChar)
    if not targetChar then return false end
    local myChar = LP.Character
    if not myChar then return false end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    local targetHead = targetChar:FindFirstChild("Head") or targetRoot
    if not myRoot or not targetRoot or not targetHead then return false end
    local origin = Cam.CFrame.Position
    local targetPos = Toggles.AimbotMultipoint.Value and targetHead.Position or targetRoot.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myChar, targetChar, Cam}
    local result = workspace:Raycast(origin, (targetPos - origin), params)
    return result == nil
end

-- ===== AIMBOT =====
local function GetClosestPlayer()
    local target, shortest = nil, Options.AimbotFov.Value
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            if Toggles.ESPTeamCheck.Value and p.Team == LP.Team then continue end
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                if Toggles.AimbotVisibleCheck.Value and not IsVisible(p.Character) then continue end
                local pos, onScreen = Cam:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
                if onScreen then
                    local d = (Vector2.new(pos.X, pos.Y) - UIS:GetMouseLocation()).Magnitude
                    if d < shortest then shortest = d; target = p.Character end
                end
            end
        end
    end
    return target
end

RunService.RenderStepped:Connect(function()
    if not Toggles.AimbotEnabled.Value or not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
    local t = GetClosestPlayer()
    if t and t:FindFirstChild("HumanoidRootPart") then
        local root = t.HumanoidRootPart
        local head = t:FindFirstChild("Head") or root
        local targetPos = Toggles.AimbotMultipoint.Value and head.Position or root.Position
        local pred = targetPos + root.Velocity * Options.AimbotPrediction.Value
        Cam.CFrame = Cam.CFrame:Lerp(CFrame.new(Cam.CFrame.Position, pred), 1 / Options.AimbotSmoothness.Value)
    end
end)

