Players.PlayerRemoving:Connect(RemoveESP)

RunService.RenderStepped:Connect(function()
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local maxDist = Options.ESPMaxDistance and Options.ESPMaxDistance.Value or 1500
    for p, data in pairs(ESP_Data) do
        local shouldHide = not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") or not myRoot
        if not shouldHide and Toggles.ESPTeamCheck.Value and p.Team == LP.Team then shouldHide = true end
        if shouldHide then
            data.box.Visible = false; data.name.Visible = false
            data.dist.Visible = false; data.health.Visible = false
            continue
        end
        local root = p.Character.HumanoidRootPart
        local hum = p.Character:FindFirstChildOfClass("Humanoid")
        local head = p.Character:FindFirstChild("Head") or root
        local distStuds = (myRoot.Position - root.Position).Magnitude
        if distStuds > maxDist then
            data.box.Visible = false; data.name.Visible = false
            data.dist.Visible = false; data.health.Visible = false
            continue
        end
        local pos, onScreen = Cam:WorldToViewportPoint(root.Position)
        local headPos = Cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        if not onScreen then
            data.box.Visible = false; data.name.Visible = false
            data.dist.Visible = false; data.health.Visible = false
            continue
        end
        local height = math.abs(pos.Y - headPos.Y) * 2.2
        local width = height * 0.6
        local boxPos = Vector2.new(pos.X - width / 2, pos.Y - height / 2)
        data.box.Visible = Toggles.ESPBox.Value
        data.box.Color = Options.ESPBoxColor.Value
        data.box.Size = Vector2.new(width, height)
        data.box.Position = boxPos
        data.name.Visible = Toggles.ESPName.Value
        data.name.Color = Options.ESPTextColor.Value
        data.name.Text = p.Name
        data.name.Position = Vector2.new(pos.X, boxPos.Y - 36)
        data.name.Center = true
        data.dist.Visible = Toggles.ESPDistance.Value
        data.dist.Color = Options.ESPTextColor.Value
        data.dist.Text = "[" .. math.floor(distStuds) .. "m]"
        data.dist.Position = Vector2.new(pos.X, boxPos.Y - 20)
        data.dist.Center = true
        if Toggles.ESPHealthBar.Value and hum then
            data.health.Visible = true
            local hp = hum.Health / hum.MaxHealth
            data.health.Color = Color3.fromRGB(255 * (1 - hp), 255 * hp, 0)
            data.health.Size = Vector2.new(3, height * hp)
            data.health.Position = Vector2.new(boxPos.X - 6, boxPos.Y + height * (1 - hp))
        else
            data.health.Visible = false
        end
    end
end)

-- ===== CHAMS =====
local chams = {}

local function ApplyChams(p)
    if p == LP or not p.Character then return end
    if chams[p] then pcall(function() chams[p]:Destroy() end) end
    local hl = Instance.new("Highlight")
    hl.Name = "SigmaChams"
    hl.FillColor = Options.ChamsFill.Value
    hl.OutlineColor = Options.ChamsOutline.Value
    hl.FillTransparency = Options.ChamsTransparency.Value
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = p.Character
    chams[p] = hl
end

local function RemoveChams(p)
    if chams[p] then pcall(function() chams[p]:Destroy() end); chams[p] = nil end
end

RunService.Heartbeat:Connect(function()
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local maxDist = Options.ChamsMaxDistance and Options.ChamsMaxDistance.Value or 1500
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        local shouldShow = Toggles.ChamsEnabled.Value and p.Character and myRoot
        if shouldShow and Toggles.ChamsTeamCheck.Value and p.Team == LP.Team then shouldShow = false end
        if shouldShow then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            if not root or (myRoot.Position - root.Position).Magnitude > maxDist then shouldShow = false end
        end
        if shouldShow then
            if not chams[p] or not chams[p].Parent then ApplyChams(p) end
            if chams[p] then
                chams[p].FillTransparency = Options.ChamsTransparency.Value
                chams[p].OutlineColor = Options.ChamsOutline.Value
                if Toggles.ChamsRainbow.Value then
                    chams[p].FillColor = Color3.fromHSV((tick() * 0.5) % 1, 1, 1)
                else
                    chams[p].FillColor = Options.ChamsFill.Value
                end
            end
        elseif chams[p] then
            RemoveChams(p)
        end
    end
end)

Players.PlayerRemoving:Connect(RemoveChams)

task.spawn(function()
    task.wait(1)
    Library:Notify("Sigma Universal v1.6.2 loaded!", 5)
end)
