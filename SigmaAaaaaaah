local crosshairRot, crosshairElapsed = 0, 0
RunService.RenderStepped:Connect(function(dt)
    pcall(function()
        dt = dt or 0
        crosshairElapsed = crosshairElapsed + dt
        crosshairRot = (crosshairRot + dt * Vars.CrosshairRotation) % 360
        if not Vars.CrosshairEnabled then
            for _, l in ipairs(crosshairLines) do l.Visible = false end
            for _, c in ipairs(crosshairCircles) do c.Visible = false end
            if crosshairDot then crosshairDot.Visible = false end
            UpdateCursorVisibility()
            return
        end
        local center = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
        local col = Vars.CrosshairColor
        if Vars.CrosshairRainbow then col = Color3.fromHSV((crosshairElapsed * 0.5) % 1, 1, 1) end
        local gap = Vars.CrosshairGap
        if Vars.CrosshairPulse then
            gap = gap + math.sin(crosshairElapsed * Vars.CrosshairPulseSpeed) * math.max(Vars.CrosshairGap * 0.4, 2)
        end
        local size = Vars.CrosshairSize
        local thick = Vars.CrosshairThickness
        local style = Vars.CrosshairStyle
        for _, l in ipairs(crosshairLines) do l.Visible = false end
        for _, c in ipairs(crosshairCircles) do c.Visible = false end
        if crosshairDot then crosshairDot.Visible = false end
        local function line(idx, angleDeg, fromDist, toDist)
            local l = crosshairLines[idx]
            if not l then return end
            local ang = math.rad(angleDeg + crosshairRot)
            local dx, dy = math.cos(ang), math.sin(ang)
            l.From = Vector2.new(center.X + dx * fromDist, center.Y + dy * fromDist)
            l.To = Vector2.new(center.X + dx * toDist, center.Y + dy * toDist)
            l.Color = col; l.Thickness = thick; l.Visible = true
        end
        if style == "Cross" then
            line(1, 0, gap, gap + size); line(2, 180, gap, gap + size)
            line(3, 90, gap, gap + size); line(4, 270, gap, gap + size)
        elseif style == "Plus" then
            line(1, 0, 0, size); line(2, 180, 0, size); line(3, 90, 0, size); line(4, 270, 0, size)
        elseif style == "X" then
            line(1, 45, gap, gap + size); line(2, 225, gap, gap + size)
            line(3, 135, gap, gap + size); line(4, 315, gap, gap + size)
        elseif style == "T-Shape" then
            line(1, 0, gap, gap + size); line(2, 180, gap, gap + size); line(3, 270, gap, gap + size)
        elseif style == "Pinwheel" then
            for i = 0, 3 do
                local baseAngle = i * 90
                line(i + 1, baseAngle, gap, gap + size)
                local hookAngle = baseAngle + 90
                local hookStart = gap + size * 0.7
                local l = crosshairLines[5 + i]
                if l then
                    local ang = math.rad(hookAngle + crosshairRot)
                    local baseRad = math.rad(baseAngle + crosshairRot)
                    local sx = center.X + math.cos(baseRad) * hookStart
                    local sy = center.Y + math.sin(baseRad) * hookStart
                    l.From = Vector2.new(sx, sy)
                    l.To = Vector2.new(sx + math.cos(ang) * size * 0.3, sy + math.sin(ang) * size * 0.3)
                    l.Color = col; l.Thickness = thick; l.Visible = true
                end
            end
        elseif style == "Star" then
            for i = 0, 5 do line(i + 1, i * 60, gap, gap + size) end
        elseif style == "Peace" then
            line(1, 0, gap, gap + size); line(2, 90, gap, gap + size)
            line(3, 180, gap, gap + size); line(4, 270, gap, gap + size)
            line(5, 45, gap, gap + size * 0.8); line(6, 135, gap, gap + size * 0.8)
        elseif style == "Circle" then
            local cr = size
            if crosshairCircles[1] and crosshairCircles[1].Type and crosshairCircles[1].Type.Name == "Circle" then
                local c = crosshairCircles[1]
                c.Position = center; c.Radius = cr; c.Thickness = thick; c.Color = col; c.Visible = true
            else
                for i, l in ipairs(crosshairCircles) do
                    local a1 = ((i - 1) / #crosshairCircles) * math.pi * 2
                    local a2 = (i / #crosshairCircles) * math.pi * 2
                    l.From = center + Vector2.new(math.cos(a1), math.sin(a1)) * cr
                    l.To = center + Vector2.new(math.cos(a2), math.sin(a2)) * cr
                    l.Color = col; l.Thickness = thick; l.Visible = true
                end
            end
        end
        if crosshairDot and (Vars.CrosshairDot or style == "Dot") then
            local ds = style == "Dot" and math.max(thick, 2) or 3
            crosshairDot.Size = Vector2.new(ds, ds)
            crosshairDot.Position = Vector2.new(center.X - ds/2, center.Y - ds/2)
            crosshairDot.Color = col; crosshairDot.Visible = true
        end
        UpdateCursorVisibility()
    end)
end)

