local MeleeKeywords = {"knife","sword","axe","bat","hammer","katana","machete","pickaxe","club","fist","stick","wrench","crowbar","dagger","blade","scythe","spear","bow","crossbow","pipe","taser","shield","guitar","shovel","hoe","rake","pan"}
local GunKeywords = {"gun","pistol","rifle","ak47","ak-47","ak74","m4","m16","shotgun","sniper","smg","revolver","deagle","glock","uzi","mp5","awp","famas","scar","lmg","minigun","launcher","rpg","bazooka","p90","vector","weapon","firearm","handgun","carbine","magnum","sks","mac-10","mac10","ump","sg","aa-12","aa12","db","double-barrel"}
local function IsGunTool(tool)
    if not tool then return false end
    local name = string.lower(tool.Name)
    for _, kw in ipairs(MeleeKeywords) do if string.find(name, kw, 1, true) then return false end end
    for _, kw in ipairs(GunKeywords) do if string.find(name, kw, 1, true) then return true end end
    if tool:FindFirstChild("Muzzle") or tool:FindFirstChild("Barrel")
       or tool:FindFirstChild("Scope") or tool:FindFirstChild("Magazine") then return true end
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("Sound") then
            local sn = string.lower(d.Name)
            if string.find(sn, "fire", 1, true) or string.find(sn, "shoot", 1, true)
               or string.find(sn, "gun", 1, true) or string.find(sn, "shot", 1, true) then return true end
        end
    end
    return false
end

local function GetFireRate(tool)
    if not tool then return 0.1 end
    local keys = {"FireDelay","FireRate","ShootCooldown","Cooldown","Delay","ShotDelay","AttackSpeed"}
    for _, k in ipairs(keys) do
        local v = tool:GetAttribute(k)
        if type(v) == "number" and v > 0 then
            if k == "FireRate" then return math.max(0.05, 1/v) end
            return math.max(0.05, math.min(2, v))
        end
    end
    for _, c in ipairs(tool:GetDescendants()) do
        if c:IsA("NumberValue") or c:IsA("IntValue") then
            local n = string.lower(c.Name)
            if (string.find(n, "fire") or string.find(n, "shoot") or string.find(n, "delay") or string.find(n, "cooldown")) then
                if c.Value > 0 and c.Value < 3 then return math.max(0.05, c.Value) end
            end
        end
    end
    return 0.1
end

