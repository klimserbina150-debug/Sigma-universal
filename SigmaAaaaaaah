local function HandleDamage(victimChar, hitPart)
    if not victimChar then return end
    local plr = Players:GetPlayerFromCharacter(victimChar); if not plr or plr == LP then return end
    if tick() - lastShotTick > 0.35 then return end
    local hum = victimChar:FindFirstChildOfClass("Humanoid"); if not hum or hum.Health <= 0 then return end
    local partName = hitPart and hitPart.Name or "Body"
    local pos = hitPart and hitPart.Position or (victimChar:FindFirstChild("HumanoidRootPart") and victimChar.HumanoidRootPart.Position)
    if Vars.HitSoundEnabled then
        local now = tick(); if now - lastHitSoundTick > 0.05 then lastHitSoundTick = now; PlayHitSound() end
    end
    if Vars.HitmarkerEnabled and pos then SpawnHitmarker(pos, false) end
    if Vars.DamageFXEnabled and pos then SpawnDamageFX(pos) end
    if Vars.HitLogsEnabled then ShowHitLog(plr.DisplayName, partName, math.floor(hum.Health), math.floor(hum.Health), false) end
end
local damageConns = {}
local function TrackDamageForPlayer(p)
    if p == LP then return end
    local function bind(char)
        local hum = char:WaitForChild("Humanoid", 5); if not hum then return end
        local prevHealth = hum.Health
        if damageConns[hum] then pcall(function() damageConns[hum]:Disconnect() end) end
        damageConns[hum] = hum.HealthChanged:Connect(function(newH)
            if newH < prevHealth - 0.01 then HandleDamage(char, char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")) end
            prevHealth = newH
        end)
    end
    if p.Character then bind(p.Character) end; p.CharacterAdded:Connect(bind)
end
